# a11y-scan environment variables — copy to .env and fill in values

# API server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Storage
DB_PATH=./data/scans.db
REPORTS_DIR=./reports

# Scanner behaviour
BROWSER=chromium          # chromium | firefox | webkit
HEADLESS=true
DEFAULT_WAIT_MS=500
MAX_PAGES_DEFAULT=1
AXE_VERSION=4.9.1         # pulled from cdnjs at runtime if AXE_LOCAL_PATH unset
AXE_LOCAL_PATH=           # absolute path to local axe.min.js (leave blank to fetch)

# Nightly scan
TARGETS_FILE=./targets.yaml
REGRESSION_THRESHOLD=5    # alert if new critical violations exceed this delta
NOTIFY_WEBHOOK_URL=       # optional Slack/Teams webhook for regression alerts
